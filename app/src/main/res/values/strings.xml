    <!-- libxposed 模块描述（管理器读取 android:description） -->
    <string name="module_description">剔除小米超级岛白名单/签名限制，支持上岛黑白名单管理，并将实况通知 SDK 的岛映射至系统原生超级岛。仅支持 HyperOS Android 15+。</string>
